{#
    Chat widget markup for GuardedChatBundle. Include it where the widget should live, usually in the
    base layout:

        {{ include('@GuardedChat/widget.html.twig') }}

    Optional variables (all have defaults):
        locale        Locale sent to the chat and used for the default texts (default: request locale)
        session_url   POST endpoint that starts a session (default: route guarded_chat_start_session)
        message_url   POST endpoint that takes a message (default: route guarded_chat_message)
        greeting      First assistant message, also the Art. 50 AI disclosure; '' hides it
        notice        Text under the title, "this is an AI" by default
        actions       List of {type, label, url} rendered under answers that carry that action
        verification_token  Static token for POST /session; use the `verify` event for dynamic ones
        root_attributes     Map of extra attributes for the root element, merged over {class: 'guarded-chat'};
                            true renders a bare attribute, false and null leave it out. The controller's
                            own data-controller and data-…-value attributes cannot be replaced.
        user_message_class, assistant_message_class
                            Classes of the message bubbles the controller renders

    To restyle, override the blocks below in your own template:

        {% extends '@GuardedChat/widget.html.twig' %}
        {% block launcher %}…{% endblock %}

    The variables above can be set there too ({% set root_attributes = {…} %} outside the blocks).
    Or copy the file to templates/bundles/GuardedChatBundle/widget.html.twig. The controller only
    relies on the data-…-target and data-action attributes, not on any class name.
#}
{% set controller = 'stejac--guarded-chat-bundle--widget' %}
{% set widget_locale = locale|default(app.request.locale|default('en')) %}
{% set t = {
    launcher: 'widget.launcher_open'|trans({}, 'guarded_chat', widget_locale),
    panel_label: 'widget.panel_label'|trans({}, 'guarded_chat', widget_locale),
    title: 'widget.panel_title'|trans({}, 'guarded_chat', widget_locale),
    notice: notice is defined ? notice : 'widget.notice'|trans({}, 'guarded_chat', widget_locale),
    greeting: greeting is defined ? greeting : 'widget.greeting'|trans({}, 'guarded_chat', widget_locale),
    close: 'widget.close'|trans({}, 'guarded_chat', widget_locale),
    typing: 'widget.typing'|trans({}, 'guarded_chat', widget_locale),
    input_label: 'widget.input_label'|trans({}, 'guarded_chat', widget_locale),
    placeholder: 'widget.input_placeholder'|trans({}, 'guarded_chat', widget_locale),
    send: 'widget.send'|trans({}, 'guarded_chat', widget_locale),
    honeypot: 'widget.honeypot_label'|trans({}, 'guarded_chat', widget_locale),
} %}
{# The blank lines after the attribute loop and the class values are intentional: Twig drops the
   first newline after a tag, and without them the next attribute would join the line. #}
{% set root_attributes = {class: 'guarded-chat'}|merge(root_attributes|default({})) %}
<div{% for name, value in root_attributes %}{% if value is not same as(false) and value is not null and name matches '/^[A-Za-z_:][-A-Za-z0-9_:.]*$/' and name != 'data-controller' and not (name starts with 'data-' ~ controller ~ '-') %} {{ name }}{% if value is not same as(true) %}="{{ value }}"{% endif %}{% endif %}{% endfor %}

     data-controller="{{ controller }}"
     data-{{ controller }}-session-url-value="{{ session_url|default(path('guarded_chat_start_session')) }}"
     data-{{ controller }}-message-url-value="{{ message_url|default(path('guarded_chat_message')) }}"
     data-{{ controller }}-locale-value="{{ widget_locale }}"
     data-{{ controller }}-greeting-value="{{ t.greeting }}"
     data-{{ controller }}-verification-token-value="{{ verification_token|default('') }}"{% if user_message_class is defined %}
     data-{{ controller }}-user-class-value="{{ user_message_class }}"{% endif %}{% if assistant_message_class is defined %}
     data-{{ controller }}-assistant-class-value="{{ assistant_message_class }}"{% endif %}

     data-{{ controller }}-error-generic-value="{{ 'widget.error_generic'|trans({}, 'guarded_chat', widget_locale) }}"
     data-{{ controller }}-error-verification-value="{{ 'widget.error_verification'|trans({}, 'guarded_chat', widget_locale) }}"
     data-{{ controller }}-error-session-expired-value="{{ 'widget.error_session_expired'|trans({}, 'guarded_chat', widget_locale) }}"
     data-{{ controller }}-error-unavailable-value="{{ 'widget.error_unavailable'|trans({}, 'guarded_chat', widget_locale) }}">
    {% block launcher %}
        <button type="button"
                class="guarded-chat__launcher"
                data-{{ controller }}-target="launcher"
                data-action="{{ controller }}#toggle"
                aria-label="{{ t.launcher }}"
                aria-expanded="false">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8-1.06 0-2.077-.163-3.02-.463L3 21l1.5-4.5C3.55 15.19 3 13.65 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8Z"/>
            </svg>
        </button>
    {% endblock %}

    <dialog class="guarded-chat__panel" data-{{ controller }}-target="panel" aria-label="{{ t.panel_label }}">
        {% block header %}
            <div class="guarded-chat__header">
                <div>
                    <span class="guarded-chat__title">{{ t.title }}</span>
                    {% block notice %}
                        {% if t.notice %}<p class="guarded-chat__notice">{{ t.notice }}</p>{% endif %}
                    {% endblock %}
                </div>
                <button type="button" class="guarded-chat__close" data-action="{{ controller }}#toggle" aria-label="{{ t.close }}">&times;</button>
            </div>
        {% endblock %}

        {% block messages %}
            <div class="guarded-chat__messages" data-{{ controller }}-target="messages" aria-live="polite"></div>
            <div class="guarded-chat__typing" data-{{ controller }}-target="typing" hidden>{{ t.typing }}</div>
        {% endblock %}

        {% block actions %}
            {# One <template> per action name the model may emit (guarded_chat.actions). The widget clones
               its first element under the answer. #}
            {% for action in actions|default([]) %}
                <template data-{{ controller }}-target="action" data-action-type="{{ action.type }}">
                    <a class="guarded-chat__action" href="{{ action.url }}">{{ action.label }}</a>
                </template>
            {% endfor %}
        {% endblock %}

        {% block form %}
            <form class="guarded-chat__form" data-action="submit->{{ controller }}#submit">
                <label class="guarded-chat__honeypot" for="guarded-chat-website" aria-hidden="true">{{ t.honeypot }}</label>
                <input type="text" id="guarded-chat-website" class="guarded-chat__honeypot"
                       data-{{ controller }}-target="honeypot" name="website" tabindex="-1"
                       autocomplete="off" aria-hidden="true" value="">
                <label class="guarded-chat__honeypot" for="guarded-chat-input">{{ t.input_label }}</label>
                <input type="text" id="guarded-chat-input" class="guarded-chat__input"
                       data-{{ controller }}-target="input" autocomplete="off"
                       maxlength="{{ max_message_length|default(500) }}" placeholder="{{ t.placeholder }}">
                <button type="submit" class="guarded-chat__send">{{ t.send }}</button>
            </form>
        {% endblock %}
    </dialog>
</div>
